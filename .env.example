NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Needed for private media, payment webhooks and finance jobs.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Paystack test/live secret key. Never use NEXT_PUBLIC_ for this value.
PAYSTACK_SECRET_KEY=
# Public origin used for payment callback URLs, e.g. http://localhost:3000 in local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Daily video (Milestone 5)
DAILY_API_KEY=

# RealSASL text search adapter (Milestone 5)
# Endpoint should accept ?q=<text> and return either an array or {results:[{word,videoUrl,...}]}
REALSASL_SEARCH_ENDPOINT=
REALSASL_SEARCH_API_KEY=

# Web Push (Milestone 6). Generate a VAPID keypair once for the deployment.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@realsign.example
# Protect the scheduled notification dispatch endpoint.
CRON_SECRET=

# Milestone 7 transactional email adapter (provider-neutral webhook)
TRANSACTIONAL_EMAIL_WEBHOOK_URL=
TRANSACTIONAL_EMAIL_WEBHOOK_SECRET=

# Used to protect scheduled job routes such as notifications, email and retention
CRON_SECRET=
